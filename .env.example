# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ──────────────────────────────────────────────

# PostgreSQL — uses Docker service name "db" as host
DATABASE_URL=postgresql://<user>:<password>@db:5432/<db_name>

# Redis — uses Docker service name "redis" as host
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# DB 1 is isolated from Celery (DB 0) to avoid key collisions
RATE_LIMIT_REDIS_URL=redis://redis:6379/1


# Gemini LLM (optional — pipeline runs with llm_failed=true if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare R2 configurations (optional — falls back to local uploads/ if empty)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

